generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── TENANT ──────────────────────────────────────────────────────

model Organization {
  id                       String    @id @default(cuid())
  name                     String
  slug                     String    @unique
  industry                 String?
  logoUrl                  String?
  isActive                 Boolean   @default(true)
  plan                     String    @default("starter")
  // Precio mensual en USD pactado con este cliente. Solo aplica a planes de
  // precio personalizado (Enterprise, PLAN_PRICES.enterprise = null); lo
  // captura un admin al cambiar el plan. Null = aún sin precio pactado.
  customMonthlyPriceUsd    Decimal?  @db.Decimal(10, 2)
  // IANA timezone name (e.g. "America/Mexico_City") — used to render
  // appointment times and to evaluate AvailabilityRule/reminder windows in
  // the org's local time rather than the server's.
  timezone                 String    @default("America/Mexico_City")
  stripeCustomerId         String?   @unique
  stripeSubscriptionId     String?   @unique
  stripeSubscriptionStatus String?
  n8nWebhookSecret         String    @unique
  // Llave opcional, separada de n8nWebhookSecret, para que un POS externo
  // (Fase 17) lea GET /api/v1/food/menu sin tener que guardar en el
  // dispositivo la misma llave que firma /api/webhooks/pos/orders -- esa
  // firma solo debe vivir en el servidor del POS, no en el punto de venta
  // físico. null hasta que un admin la genera desde el panel; nunca se
  // usa para firmar nada.
  foodPosReadKey           String?   @unique
  // Set once the org's onboarding checklist (src/lib/onboarding.ts) is
  // either fully completed or explicitly skipped — null means "still
  // showing the setup nudge on the dashboard" (Fase 10).
  onboardingCompletedAt    DateTime?
  // % objetivo de costo de insumos sobre el precio de venta, usado por la
  // calculadora de precio recomendado del módulo Food (precio sugerido =
  // costo del platillo ÷ este %). 30% es el punto de partida típico de la
  // industria restaurantera; editable por organización.
  foodTargetCostPct        Int       @default(30)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  users                   User[]
  leads                   Lead[]
  automations             Automation[]
  conversations           Conversation[]
  appointments            Appointment[]
  requests                Request[]
  metrics                 Metric[]
  auditLogs               AuditLog[]
  webhookEvents           WebhookEvent[]
  whatsappAssistant       WhatsAppAssistant?
  knowledgeBase           KnowledgeBase[]
  prompts                 Prompt[]
  templateInstallations   TemplateInstallation[]
  modules                 OrganizationModule[]
  pipelineStages          PipelineStage[]
  opportunities           Opportunity[]
  notes                   Note[]
  services                Service[]
  availabilityRules       AvailabilityRule[]
  reminderRules           AppointmentReminderRule[]
  followUpRules           FollowUpRule[]
  aiSandboxSessions       AiSandboxSession[]
  promptTestCases         PromptTestCase[]
  promptExperiments       PromptExperiment[]
  foodSales               FoodSale[]
  foodInventoryItems      FoodInventoryItem[]
  foodSuppliers           FoodSupplier[]
  foodDishes              FoodDish[]
  foodDishCategories      FoodDishCategory[]
  foodDishVariants        FoodDishVariant[]
  foodDishSales           FoodDishSale[]
  foodOperatingCosts      FoodOperatingCost[]
  foodModifierGroups      FoodModifierGroup[]
  foodModifierOptionSales FoodModifierOptionSale[]
  foodInventoryMovements  FoodInventoryMovement[]
  foodPurchases           FoodPurchase[]
  foodRecipeUsages        FoodRecipeUsage[]
  deliveryChannels        DeliveryChannel[]
  deliveryOrders          DeliveryOrder[]

  @@index([slug])
}

// ─── USERS & AUTH ─────────────────────────────────────────────────

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  name                 String?
  image                String?
  passwordHash         String?
  role                 UserRole  @default(CLIENT)
  organizationId       String?
  isActive             Boolean   @default(true)
  theme                String?   @default("light")
  language             String?   @default("es")
  notificationsSeenAt  DateTime? // last time the user opened the notification bell — items newer than this still count as unread
  totpSecret           String? // base32 TOTP secret; set once enrollment begins
  totpEnabled          Boolean   @default(false)
  totpBackupCodeHashes String[]  @default([]) // bcrypt hashes, single-use, cleared/regenerated on re-enroll
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization          Organization?  @relation(fields: [organizationId], references: [id])
  accounts              Account[]
  sessions              Session[]
  ownedOpportunities    Opportunity[]
  authoredNotes         Note[]
  assignedConversations Conversation[] @relation("ConversationAssignee")
  sentMessages          Message[]      @relation("MessageSender")

  @@index([organizationId])
  @@index([email])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  OWNER
  MANAGER
  AGENT
  VIEWER
  CLIENT
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── LEADS CRM ────────────────────────────────────────────────────

model Lead {
  id             String     @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  // Últimos 10 dígitos del teléfono (ver src/lib/phone.ts): sirve para unir
  // conversaciones y detectar duplicados aunque el formato del número cambie.
  phoneKey       String?
  source         String?
  // Caller-supplied idempotency key (e.g. the lead's ID in the client's own
  // CRM, or a WhatsApp message ID) — lets a resent/retried webhook upsert
  // the same Lead instead of creating a duplicate. Null when the source
  // doesn't provide one (manual portal creation, or a legacy n8n workflow
  // not yet updated), in which case no dedup is possible for that lead.
  externalId     String?
  status         LeadStatus @default(NEW)
  score          Int?
  scoreReason    String?    @db.Text
  notes          String?    @db.Text
  // Free-text tags for quick contact-level categorization (same pattern as
  // KnowledgeBase.tags / AutomationTemplate.tags elsewhere in this schema —
  // a plain array, not a separate Tag model, since nothing here needs
  // cross-org tag reuse or tag-level metadata).
  tags           String[]   @default([])
  metadata       Json?
  assignedTo     String?
  // Opt-out flag: a lead with this set is never a candidate for automated
  // follow-ups (see FollowUpRule below), regardless of status or timing.
  doNotContact   Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  organization  Organization  @relation(fields: [organizationId], references: [id])
  opportunities Opportunity[]
  noteHistory   Note[]
  appointments  Appointment[]
  followUpLogs  FollowUpLog[]
  conversations Conversation[]

  @@unique([organizationId, externalId])
  @@index([organizationId])
  @@index([organizationId, phoneKey])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

// ─── SALES PIPELINE (Opportunities) ──────────────────────────────
// A Lead is the contact/lead identity (unchanged, see above) — an
// Opportunity is a deal being worked in a configurable pipeline against
// that contact. One Lead can have zero, one, or several Opportunities
// over time (a returning customer, a second sale). Kept separate from
// Lead.status (the simpler, fixed CRM funnel every org already uses) so
// existing leads/webhooks/reports keep working unchanged; Opportunity is
// purely additive.

model PipelineStage {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  order          Int
  isWon          Boolean  @default(false)
  isLost         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id])
  opportunities Opportunity[]

  @@unique([organizationId, order])
  @@index([organizationId])
}

model Opportunity {
  id                 String    @id @default(cuid())
  organizationId     String
  leadId             String
  pipelineStageId    String
  title              String
  // Monetary amount as a plain float, matching this schema's existing
  // pragmatic style (Metric.value is also Float) rather than introducing
  // Prisma's Decimal type solely for this — precise accounting isn't a
  // requirement here, "how big is this deal" for pipeline/reporting is.
  amount             Float?
  currency           String    @default("MXN")
  ownerId            String?
  estimatedCloseDate DateTime?
  nextActivityAt     DateTime?
  nextActivityNote   String?   @db.Text
  lossReason         String?   @db.Text
  tags               String[]  @default([])
  closedAt           DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id])
  lead          Lead          @relation(fields: [leadId], references: [id])
  pipelineStage PipelineStage @relation(fields: [pipelineStageId], references: [id])
  owner         User?         @relation(fields: [ownerId], references: [id])

  @@index([organizationId])
  @@index([organizationId, pipelineStageId])
  @@index([leadId])
  @@index([ownerId])
}

model Note {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String
  authorId       String?
  content        String   @db.Text
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  lead         Lead         @relation(fields: [leadId], references: [id])
  author       User?        @relation(fields: [authorId], references: [id])

  @@index([leadId])
  @@index([organizationId])
}

// ─── AUTOMATIONS ──────────────────────────────────────────────────

model Automation {
  id             String           @id @default(cuid())
  organizationId String
  name           String
  description    String?
  type           String
  status         AutomationStatus @default(ACTIVE)
  n8nWorkflowId  String?
  webhookSecret  String
  config         Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id])
  events       AutomationEvent[]

  @@index([organizationId])
}

enum AutomationStatus {
  ACTIVE
  PAUSED
  ERROR
  ARCHIVED
}

model AutomationEvent {
  id             String      @id @default(cuid())
  automationId   String
  organizationId String
  type           String
  status         EventStatus @default(PENDING)
  payload        Json?
  errorMessage   String?
  duration       Int?
  createdAt      DateTime    @default(now())

  automation Automation @relation(fields: [automationId], references: [id])

  @@index([automationId])
  @@index([organizationId, createdAt])
}

enum EventStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
}

// ─── CONVERSATIONS ────────────────────────────────────────────────

model Conversation {
  id             String             @id @default(cuid())
  organizationId String
  channel        String
  contactPhone   String?
  // Misma llave que Lead.phoneKey, para encontrar la conversación aunque el
  // número llegue con otro formato.
  phoneKey       String?
  // Contacto del CRM con el que está enlazada (null si aún no hay uno).
  leadId         String?
  contactName    String?
  status         ConversationStatus @default(OPEN)
  aiHandled      Boolean            @default(true)
  assignedToId   String?
  escalatedAt    DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  assignedTo   User?        @relation("ConversationAssignee", fields: [assignedToId], references: [id])
  lead         Lead?        @relation(fields: [leadId], references: [id])
  messages     Message[]

  @@index([organizationId])
  @@index([organizationId, phoneKey])
  @@index([leadId])
  @@index([organizationId, status])
  @@index([organizationId, assignedToId])
}

enum ConversationStatus {
  OPEN
  ESCALATED
  RESOLVED
  CLOSED
}

model Message {
  id             String                 @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String                 @db.Text
  metadata       Json?
  // Same idempotency-key pattern as Lead.externalId — dedupes a retried
  // "new message" webhook (e.g. the provider's own message ID) instead of
  // appending the same message twice.
  externalId     String?
  // Set only for role=AGENT (a human reply sent from the portal) — null for
  // USER/ASSISTANT/SYSTEM, which have no platform user as their sender.
  senderId       String?
  attachmentUrl  String?                @db.Text
  attachmentType String?
  // Only tracked for outbound sends (role=AGENT/ASSISTANT) — n8n reports
  // status transitions back via the message.status webhook once it hears
  // from the WhatsApp Business API. Null for inbound USER/SYSTEM messages.
  deliveryStatus MessageDeliveryStatus?
  createdAt      DateTime               @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User?        @relation("MessageSender", fields: [senderId], references: [id])

  @@unique([conversationId, externalId])
  @@index([conversationId])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  AGENT
}

enum MessageDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

// ─── APPOINTMENTS ─────────────────────────────────────────────────

model Appointment {
  id             String            @id @default(cuid())
  organizationId String
  leadId         String?
  serviceId      String?
  title          String
  description    String?
  startTime      DateTime
  endTime        DateTime
  status         AppointmentStatus @default(SCHEDULED)
  source         String?
  metadata       Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id])
  lead         Lead?                    @relation(fields: [leadId], references: [id])
  service      Service?                 @relation(fields: [serviceId], references: [id])
  reminderLogs AppointmentReminderLog[]

  @@index([organizationId])
  @@index([organizationId, startTime])
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

// ─── SERVICES & AVAILABILITY (Agenda) ──────────────────────────────

model Service {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  description     String?  @db.Text
  durationMinutes Int
  // Minimum gap enforced after this service's own appointments — does not
  // retroactively apply to existing appointments booked without a service.
  bufferMinutes   Int      @default(0)
  price           Float?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  appointments Appointment[]

  @@index([organizationId])
}

// A recurring weekly open window (e.g. Mon-Fri 9:00-18:00 = dayOfWeek 1-5,
// startMinute 540, endMinute 1080). Evaluated in the organization's own
// timezone. No rows for an org means "no restriction configured" — bookings
// are allowed at any time, preserving today's behavior until an org opts in.
model AvailabilityRule {
  id             String   @id @default(cuid())
  organizationId String
  dayOfWeek      Int // 0 = Sunday .. 6 = Saturday
  startMinute    Int // minutes since local midnight
  endMinute      Int
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([organizationId, dayOfWeek])
}

// Configuration only — the platform never sends the reminder itself. n8n
// polls GET /api/v1/appointments/due-reminders on its own schedule and sends
// the actual WhatsApp message, then reports success via
// POST /api/webhooks/n8n/appointment-reminder-sent (logged in
// AppointmentReminderLog so the same reminder is never sent twice).
model AppointmentReminderRule {
  id             String   @id @default(cuid())
  organizationId String
  // How long before the appointment's startTime this rule fires, e.g. 1440
  // (24h) or 60 (1h).
  offsetMinutes  Int
  channel        String   @default("whatsapp")
  template       String   @db.Text
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model AppointmentReminderLog {
  id            String   @id @default(cuid())
  appointmentId String
  ruleId        String
  sentAt        DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@unique([appointmentId, ruleId])
}

// ─── AUTOMATED FOLLOW-UPS (Leads) ───────────────────────────────────
// Same "platform stores config, n8n executes" principle as appointment
// reminders above — see docs/DOCUMENTACION_TECNICA.md §7. No cron lives
// inside the platform for this; n8n polls /api/v1/leads/due-followups on
// its own schedule and reports each send via
// /api/webhooks/n8n/followup-sent.

model FollowUpRule {
  id                    String     @id @default(cuid())
  organizationId        String
  name                  String
  // A lead is only a candidate while its status matches this — leaving the
  // status (e.g. moving to WON/LOST, or being manually re-contacted into
  // CONTACTED) is itself the "stop" condition; no separate flag needed.
  triggerStatus         LeadStatus
  // Minutes since the lead last changed (Lead.updatedAt) before the first
  // attempt fires.
  delayMinutes          Int
  // If set, the rule fires again this many minutes after the previous
  // attempt, up to maxAttempts. Null means "fire at most once per lead".
  repeatIntervalMinutes Int?
  maxAttempts           Int        @default(1)
  channel               String     @default("whatsapp")
  template              String     @db.Text
  isActive              Boolean    @default(true)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

// One row per attempt (not unique per lead+rule) — a repeating rule fires
// more than once, and attempts-so-far is simply a count of these rows.
model FollowUpLog {
  id     String   @id @default(cuid())
  leadId String
  ruleId String
  sentAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id])

  @@index([leadId, ruleId])
}

// ─── REQUESTS ─────────────────────────────────────────────────────

model Request {
  id             String        @id @default(cuid())
  organizationId String
  title          String
  description    String        @db.Text
  type           String
  status         RequestStatus @default(OPEN)
  priority       String        @default("medium")
  resolvedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

enum RequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ─── METRICS ──────────────────────────────────────────────────────

model Metric {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  value          Float
  period         String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, key, period])
  @@index([organizationId, period])
}

// ─── WEBHOOK EVENTS ───────────────────────────────────────────────

model WebhookEvent {
  id              String             @id @default(cuid())
  organizationId  String
  source          String
  eventType       String
  payload         Json
  status          WebhookEventStatus @default(PENDING)
  attempts        Int                @default(0)
  processedAt     DateTime?
  errorMessage    String?
  // Caller-supplied idempotency key for the raw delivery itself (distinct
  // from Lead/Message.externalId, which identifies the domain entity) —
  // lets the route recognize "I've already ingested this exact delivery"
  // and short-circuit before ever calling a processor, independent of
  // whether that processor call would itself be safe to repeat.
  externalEventId String?
  createdAt       DateTime           @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, source, externalEventId])
  @@index([organizationId, status])
  @@index([createdAt])
}

enum WebhookEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

// ─── AUDIT LOGS ───────────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  action         String
  resource       String
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([userId])
}

// ─── WHATSAPP AI ASSISTANT ────────────────────────────────────────

model WhatsAppAssistant {
  id             String   @id @default(cuid())
  organizationId String   @unique
  name           String   @default("Asistente AI")
  greeting       String   @default("¡Hola! Soy el asistente virtual. ¿En qué puedo ayudarte?") @db.Text
  personality    String?  @db.Text
  capabilities   String[]
  isActive       Boolean  @default(true)
  phoneNumber    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
}

// ─── KNOWLEDGE BASE ───────────────────────────────────────────────

model KnowledgeBase {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  content        String   @db.Text
  category       String?
  tags           String[]
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([organizationId, category])
  @@index([organizationId, isActive])
}

// ─── PROMPT MANAGER ───────────────────────────────────────────────

model Prompt {
  id             String     @id @default(cuid())
  organizationId String
  name           String
  content        String     @db.Text
  type           PromptType
  isActive       Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id])
  versions     PromptVersion[]

  @@index([organizationId])
  @@index([organizationId, type])
  @@index([organizationId, type, isActive])
}

enum PromptType {
  SYSTEM
  GREETING
  LEAD_QUALIFICATION
  APPOINTMENT_BOOKING
  FAQ
  ESCALATION
}

// ─── AI LAB (Fase 7): prompt versioning, sandbox, test cases, A/B ──
//
// Every edit to a Prompt's content is snapshotted here instead of being
// overwritten in place — the same "never destructive" principle as
// TemplateVersion (§11). `Prompt.content`/`updatedAt` always mirrors the
// latest version so every existing read path (portal prompts page, the
// n8n knowledge/prompt pull, etc.) keeps working unchanged; PromptVersion
// is purely additive history used by rollback, test-case runs, and A/B
// experiments, which pin an exact version rather than "whatever is live
// right now".
model PromptVersion {
  id        String   @id @default(cuid())
  promptId  String
  version   Int
  content   String   @db.Text
  changelog String?  @db.Text
  createdBy String? // userId who authored this version, when known
  isLatest  Boolean  @default(true)
  createdAt DateTime @default(now())

  prompt          Prompt                 @relation(fields: [promptId], references: [id], onDelete: Cascade)
  testCaseResults PromptTestCaseResult[]
  experimentsAsA  PromptExperiment[]     @relation("ExperimentVariantA")
  experimentsAsB  PromptExperiment[]     @relation("ExperimentVariantB")

  @@unique([promptId, version])
  @@index([promptId])
}

// An isolated conversation used to try out prompts/knowledge base changes
// without touching a real Conversation/Lead — nothing here is ever synced
// to WhatsApp or visible to a real contact.
model AiSandboxSession {
  id              String   @id @default(cuid())
  organizationId  String
  name            String   @default("Sesión de prueba")
  // Which draft/version is under test in this session, pinned at creation
  // for reproducibility — a plain reference (no FK/relation), same
  // lightweight-pointer convention as Lead.assignedTo, since it's read-only
  // display data, never joined on.
  promptVersionId String?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id])
  messages     AiSandboxMessage[]

  @@index([organizationId])
}

model AiSandboxMessage {
  id                   String      @id @default(cuid())
  sessionId            String
  role                 MessageRole // USER (tester's turn) | ASSISTANT (n8n's generated reply)
  content              String      @db.Text
  // KnowledgeBase article ids sent as context for this reply — an honest
  // "what the assistant had available", not a claim about what it actually
  // used; ASSISTANT messages only.
  knowledgeBaseContext String[]
  latencyMs            Int?
  createdAt            DateTime    @default(now())

  session AiSandboxSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

// A saved input, reusable across prompt versions, so a prompt change can be
// checked against the same set of messages every time instead of ad hoc
// sandbox chat.
model PromptTestCase {
  id             String     @id @default(cuid())
  organizationId String
  promptType     PromptType
  name           String
  userMessage    String     @db.Text
  expectedNotes  String?    @db.Text // human-readable grading criteria, not a fixed string match
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id])
  results      PromptTestCaseResult[]

  @@index([organizationId])
  @@index([organizationId, promptType])
}

model PromptTestCaseResult {
  id                   String   @id @default(cuid())
  testCaseId           String
  promptVersionId      String
  reply                String   @db.Text
  knowledgeBaseContext String[]
  passed               Boolean? // null = ungraded; a human grades it, there's no automatic judge
  gradedBy             String?
  latencyMs            Int?
  createdAt            DateTime @default(now())

  testCase      PromptTestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  promptVersion PromptVersion  @relation(fields: [promptVersionId], references: [id], onDelete: Cascade)

  @@index([testCaseId])
  @@index([promptVersionId])
}

// Side-by-side comparison of two versions of the same prompt type. Each
// sample runs the same user message through both variants; a human picks
// the winner per sample, then can close out the experiment with an overall
// winner (which the prompts UI can then offer to activate).
model PromptExperiment {
  id             String           @id @default(cuid())
  organizationId String
  promptType     PromptType
  name           String
  variantAId     String
  variantBId     String
  status         ExperimentStatus @default(RUNNING)
  winnerVariant  String? // "A" | "B" | "TIE"
  createdAt      DateTime         @default(now())
  completedAt    DateTime?

  organization Organization             @relation(fields: [organizationId], references: [id])
  variantA     PromptVersion            @relation("ExperimentVariantA", fields: [variantAId], references: [id])
  variantB     PromptVersion            @relation("ExperimentVariantB", fields: [variantBId], references: [id])
  samples      PromptExperimentSample[]

  @@index([organizationId])
  @@index([organizationId, promptType])
}

enum ExperimentStatus {
  RUNNING
  COMPLETED
}

model PromptExperimentSample {
  id           String   @id @default(cuid())
  experimentId String
  userMessage  String   @db.Text
  replyA       String   @db.Text
  replyB       String   @db.Text
  preferred    String? // "A" | "B" | "TIE", set when a human judges this sample
  createdAt    DateTime @default(now())

  experiment PromptExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@index([experimentId])
}

// ─── TEMPLATE ENGINE ──────────────────────────────────────────────

model AutomationTemplate {
  id              String   @id @default(cuid())
  name            String
  description     String   @db.Text
  longDescription String?  @db.Text
  industry        String // clinic, real_estate, gym, legal, workshop, ecommerce
  category        String // lead_capture, appointments, follow_up, crm, retention
  tags            String[]
  iconEmoji       String   @default("⚡")
  isPublished     Boolean  @default(false)
  currentVersion  String? // latest semver e.g. "1.0.0"
  createdBy       String? // userId
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  versions      TemplateVersion[]
  installations TemplateInstallation[]
  packageItems  TemplatePackageItem[]

  @@index([industry])
  @@index([isPublished])
}

// A curated, one-click bundle of existing AutomationTemplates for one
// industry — e.g. "Paquete inicial de Clínica" = 3 templates a clinic
// typically wants installed together. Doesn't duplicate anything about the
// templates themselves (workflow JSON, versions) — it's just an ordered
// grouping; installing a package installs each member template through the
// exact same code path (and the exact same module/plan-capacity checks) as
// installing one template individually.
model TemplatePackage {
  id          String   @id @default(cuid())
  name        String
  description String   @db.Text
  industry    String // same domain as AutomationTemplate.industry
  iconEmoji   String   @default("📦")
  isPublished Boolean  @default(false)
  createdBy   String? // userId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items TemplatePackageItem[]

  @@index([industry])
  @@index([isPublished])
}

model TemplatePackageItem {
  id         String @id @default(cuid())
  packageId  String
  templateId String
  order      Int    @default(0)

  package  TemplatePackage    @relation(fields: [packageId], references: [id], onDelete: Cascade)
  template AutomationTemplate @relation(fields: [templateId], references: [id])

  @@unique([packageId, templateId])
  @@index([packageId])
  @@index([templateId])
}

model TemplateVersion {
  id              String   @id @default(cuid())
  templateId      String
  version         String // "1.0.0"
  changelog       String?  @db.Text
  n8nWorkflowJson Json // full n8n workflow export JSON
  n8nWorkflowId   String? // ID of deployed workflow in n8n instance
  defaultConfig   Json? // default variable values for this version
  isLatest        Boolean  @default(true)
  createdAt       DateTime @default(now())

  template      AutomationTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  installations TemplateInstallation[]

  @@unique([templateId, version])
  @@index([templateId])
  @@index([templateId, isLatest])
}

model TemplateInstallation {
  id             String             @id @default(cuid())
  organizationId String
  templateId     String
  versionId      String
  automationId   String? // FK to Automation created on install
  status         InstallationStatus @default(PENDING)
  config         Json? // org-specific config overrides
  installedAt    DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id])
  template     AutomationTemplate @relation(fields: [templateId], references: [id])
  version      TemplateVersion    @relation(fields: [versionId], references: [id])

  @@unique([organizationId, templateId])
  @@index([organizationId])
  @@index([templateId])
}

enum InstallationStatus {
  PENDING
  INSTALLING
  ACTIVE
  FAILED
  UNINSTALLED
}

// ─── PLATFORM MODULES (commercial entitlements) ──────────────────────
// Distinct from RBAC (src/lib/permissions.ts, what a user may do) and from
// feature flags (gradual rollout of experimental functionality within an
// already-enabled module). A module here answers "does this organization's
// account have access to this line of business at all" — CRM, the AI/
// WhatsApp assistant, and Automations are the only modules with real
// functionality today; NFC_QR and MARKETING_ADS are reserved for future
// modules (see docs/DOCUMENTACION_TECNICA.md) and have no schema/UI of
// their own yet.

enum PlatformModule {
  CRM
  AI_WHATSAPP
  AUTOMATIONS
  NFC_QR // reserved — no schema/UI yet, integration point for a separate future repo
  MARKETING_ADS // reserved — no schema/UI yet, future module
  FOOD_OPS // restaurant ops — Sales/Inventory/Suppliers have real models below; Recipes/Operations are view-only placeholders for now
  // El restaurante vende con Reymen POS: las ventas llegan solas por el webhook
  // del POS, así que la captura manual de ventas (que las duplicaría o
  // reemplazaría) se bloquea. Requiere FOOD_OPS.
  REYMEN_POS
}

enum ModuleStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum ModuleSource {
  SUBSCRIBED // tied to a paid plan (billing wiring not implemented yet)
  ADMIN_GRANTED // enabled manually by a Reymen admin (trial, courtesy, etc.)
}

model OrganizationModule {
  id             String         @id @default(cuid())
  organizationId String
  module         PlatformModule
  status         ModuleStatus   @default(ACTIVE)
  source         ModuleSource   @default(SUBSCRIBED)
  enabledAt      DateTime       @default(now())
  suspendedAt    DateTime?
  cancelledAt    DateTime?
  notes          String?        @db.Text // why it was granted/suspended — admin-only visibility
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, module])
  @@index([organizationId])
}

// ─── FOOD OPS (módulo FOOD_OPS, Fase inicial) ──────────────────────
// Solo Ventas, Inventario y Proveedores tienen modelo real por ahora —
// Recetas y Operación (mesas/turnos/tickets) son vistas de solo lectura
// sin tabla propia todavía (ver src/app/(portal)/portal/food). Se agrega
// así, incompleto mas explícito, en vez de simular con datos falsos en
// páginas que aparentan estar conectadas a algo real.

model FoodSale {
  id             String         @id @default(cuid())
  organizationId String
  // Fecha del negocio a la que pertenece la venta -- no necesariamente el
  // mismo día que createdAt si algún día se permite captura tardía.
  occurredAt     DateTime       @default(now())
  // Canal de venta (mostrador, domicilio, app, etc.) -- texto libre por
  // ahora, igual que Lead.source; si más adelante hace falta un catálogo
  // fijo con reportes por canal, se vuelve enum entonces.
  channel        String?
  grossAmount    Decimal        @db.Decimal(10, 2)
  netAmount      Decimal        @db.Decimal(10, 2)
  notes          String?        @db.Text
  // Quién la registró: una venta del POS nunca se edita ni se borra desde
  // el portal (la corrección es una cancelación en el POS); una manual sí.
  source         FoodSaleSource @default(MANUAL)
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([organizationId, occurredAt])
}

enum FoodSaleSource {
  MANUAL
  POS
}

enum FoodInventoryCategory {
  EDIBLE
  NON_EDIBLE
}

model FoodInventoryItem {
  id             String                @id @default(cuid())
  organizationId String
  name           String
  unit           String // "kg", "lt", "pza", etc. -- texto libre, mismo criterio que FoodSale.channel
  category       FoodInventoryCategory @default(EDIBLE)
  // 3 decimales, igual que FoodDishVariantIngredient.quantity: las recetas
  // descuentan porciones como 0.150 kg y con 2 decimales se perdían.
  currentStock   Decimal               @default(0) @db.Decimal(12, 3)
  minStock       Decimal               @default(0) @db.Decimal(12, 3)
  unitCost       Decimal?              @db.Decimal(10, 2)
  // Desactivado: ya no aparece para compras ni recetas nuevas, pero conserva
  // su historial (compras, movimientos) y las recetas que ya lo usan.
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization  Organization                   @relation(fields: [organizationId], references: [id])
  dishLinks     FoodDishVariantIngredient[]
  modifierLinks FoodModifierOptionIngredient[]
  movements     FoodInventoryMovement[]
  purchaseItems FoodPurchaseItem[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model FoodSupplier {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  contactName    String?
  phone          String?
  email          String?
  notes          String?  @db.Text
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id])
  purchases    FoodPurchase[]

  @@index([organizationId])
}

// ─── FOOD OPS — Movimientos de inventario ────────────────────────────
// Cada cambio a FoodInventoryItem.currentStock deja aquí un renglón con su
// motivo, para poder explicar cualquier existencia ("¿por qué quedan 3 kg?").
// quantity va con signo: negativo resta, positivo suma. stockAfter es la
// existencia justo después del movimiento.
enum FoodInventoryMovementType {
  SALE // venta del POS: receta × unidades vendidas
  SALE_CANCELLATION // cancelación de una venta del POS: devuelve los insumos
  MANUAL_DISH_SALES // captura manual de "ventas de hoy por platillo" (sin POS)
  PURCHASE // compra registrada
  PURCHASE_VOID // compra anulada: quita lo que había sumado
  ADJUSTMENT // conteo físico / corrección manual
  RECIPE_RECALC // ventas anteriores recalculadas con la receta actual
  STOCK_IN // ingreso de stock sin compra registrada (donación, traspaso, inventario inicial)
  PRODUCTION // producción de un preparado: suma el preparado y resta sus insumos (mismo batchId)
  WASTE // desecho / merma con motivo
}

model FoodInventoryMovement {
  id              String                    @id @default(cuid())
  organizationId  String
  inventoryItemId String
  type            FoodInventoryMovementType
  quantity        Decimal                   @db.Decimal(12, 3)
  stockAfter      Decimal                   @db.Decimal(12, 3)
  foodSaleId      String?
  purchaseId      String?
  // Agrupa los movimientos de un mismo ajuste rápido (p. ej. una producción:
  // el preparado que entra y los insumos que salen).
  batchId         String?
  note            String?                   @db.Text
  // Quién lo hizo (null = automático, p. ej. una venta del POS). Sin FK, igual
  // que AuditLog: el historial no debe depender de que el usuario exista.
  userId          String?
  createdAt       DateTime                  @default(now())

  organization  Organization      @relation(fields: [organizationId], references: [id])
  inventoryItem FoodInventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([inventoryItemId, createdAt])
  @@index([batchId])
}

// ─── FOOD OPS — Compras ──────────────────────────────────────────────
// Una compra suma sus cantidades a las existencias y deja el costo unitario
// pagado como el costo actual del insumo (último costo de compra). Anular
// una compra quita lo que sumó y, si su costo sigue siendo el vigente,
// regresa el costo que había antes (FoodPurchaseItem.previousUnitCost).
model FoodPurchase {
  id             String    @id @default(cuid())
  organizationId String
  supplierId     String?
  purchasedAt    DateTime
  total          Decimal   @db.Decimal(12, 2)
  notes          String?   @db.Text
  userId         String?
  voidedAt       DateTime?
  voidReason     String?   @db.Text
  createdAt      DateTime  @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id])
  supplier     FoodSupplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items        FoodPurchaseItem[]

  @@index([organizationId, purchasedAt])
}

model FoodPurchaseItem {
  id               String   @id @default(cuid())
  purchaseId       String
  inventoryItemId  String
  quantity         Decimal  @db.Decimal(12, 3)
  unitCost         Decimal  @db.Decimal(10, 2)
  // Costo del insumo justo antes de esta compra, para regresarlo si se anula.
  previousUnitCost Decimal? @db.Decimal(10, 2)

  purchase      FoodPurchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  inventoryItem FoodInventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([purchaseId])
  @@index([inventoryItemId])
}

// ─── FOOD OPS — Platillos, costeo y rentabilidad (Fase 2) ────────────
// Un FoodDish es el "producto de menú" (ej. "Berry Bloom") y siempre tiene
// una o más FoodDishVariant (ej. "Chico"/"Grande", o "Único" si no maneja
// tamaños) -- cada variante tiene su propio precio Y su propia receta
// (FoodDishVariantIngredient), porque un tamaño grande normalmente lleva
// más insumo, no el mismo costo escalado a ojo. FoodDishSale es un
// registro DIARIO adicional y opcional de cuántas unidades de CADA
// VARIANTE se vendieron -- separado a propósito de FoodSale (que sigue
// siendo solo el total en pesos del día, sin cambios): así utilidad neta y
// "platillos menos vendidos" se calculan con datos reales solo donde
// existan, sin forzar a rehacer el flujo de captura de ventas que ya
// existe ni inventar una mezcla de ventas.

// Agrupación de menú para un POS (ej. "Bebidas", "Entradas") -- opcional a
// propósito (categoryId es nullable en FoodDish): un platillo sin
// categorizar sigue siendo válido, solo no aparece agrupado en el grid del
// POS. onDelete: SetNull en FoodDish.category, nunca se borra un platillo
// solo porque se borró su categoría.
model FoodDishCategory {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  dishes       FoodDish[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model FoodDish {
  id             String   @id @default(cuid())
  organizationId String
  categoryId     String?
  name           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization            @relation(fields: [organizationId], references: [id])
  category       FoodDishCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants       FoodDishVariant[]
  modifierGroups FoodDishModifierGroup[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([categoryId])
}

model FoodDishVariant {
  id             String   @id @default(cuid())
  dishId         String
  // Denormalizado desde dish.organizationId (mismo criterio que
  // FoodDishSale.organizationId) -- permite indexar/filtrar por org y
  // aplicar la unicidad de externalPosId sin pasar por dish en cada query.
  organizationId String
  // "Único" para un platillo sin tamaños/variantes reales -- así el resto
  // del modelo (precio, receta, ventas) no necesita un caso especial para
  // "no tiene variantes". "Chico"/"Grande", "Salmón"/"Pollo", etc. cuando sí.
  label          String
  price          Decimal  @db.Decimal(10, 2)
  // Id de este ítem/variante en un POS externo, una vez que exista esa
  // integración -- null hasta entonces. Permite mapear "ítem del POS" a
  // esta variante sin adivinar por nombre (mismo criterio que
  // Lead.externalId).
  externalPosId  String?
  // Una variante con ventas no se borra al quitarla del platillo: se
  // desactiva, para conservar su historial de ventas y de consumo. Deja de
  // aparecer en el menú y en el formulario; si se vuelve a agregar con el
  // mismo nombre, se reactiva.
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  dish         FoodDish                    @relation(fields: [dishId], references: [id], onDelete: Cascade)
  organization Organization                @relation(fields: [organizationId], references: [id])
  ingredients  FoodDishVariantIngredient[]
  sales        FoodDishSale[]
  recipeUsages FoodRecipeUsage[]

  @@unique([dishId, label])
  @@unique([organizationId, externalPosId])
  @@index([dishId])
  @@index([organizationId])
}

model FoodDishVariantIngredient {
  id              String  @id @default(cuid())
  variantId       String
  inventoryItemId String
  // Cantidad del insumo que usa una sola porción de ESTA variante, en la
  // misma unidad que FoodInventoryItem.unit para ese insumo (kg, lt, pza...).
  // Decimal(10,3) para porciones chicas tipo 0.150 kg.
  quantity        Decimal @db.Decimal(10, 3)

  variant       FoodDishVariant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  inventoryItem FoodInventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@unique([variantId, inventoryItemId])
  @@index([variantId])
}

model FoodDishSale {
  id             String   @id @default(cuid())
  organizationId String
  variantId      String
  // Fecha de negocio, mismo criterio que FoodSale.occurredAt -- siempre a
  // medianoche local del día que se está registrando (no una hora exacta).
  // Dos escrituras distintas mantienen esta fila, con semántica distinta
  // cada una (ver logFoodDishSales() vs. el webhook de POS en
  // /api/webhooks/pos/orders): la captura manual del portal REEMPLAZA la
  // cantidad del día completo (corrige un error de captura sin duplicar);
  // el webhook del POS la SUMA por cada orden que llega (varias ventas
  // reales del mismo día para la misma variante). No se mezclan en la
  // práctica -- un restaurante que ya usa el POS deja de capturar a mano.
  occurredAt     DateTime @default(now())
  quantity       Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id])
  variant      FoodDishVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, occurredAt])
  @@index([organizationId, occurredAt])
}

// ─── FOOD OPS — Modificadores (Fase 17: integración con POS) ─────────
// Un grupo de opciones reutilizable entre varios platillos (ej. "Término"
// con Crudo/Medio/Bien cocido, minSelect=maxSelect=1 -- obligatorio elegir
// uno; "Extras" con Extra queso/Extra tocino, minSelect=0 maxSelect=3 --
// opcional, varias). Vive a nivel FoodDish (no por variante): el
// modificador aplica igual sin importar el tamaño elegido. Sin costo de
// insumo asociado todavía -- a diferencia de FoodDishVariantIngredient,
// esto es solo para que el POS muestre las opciones y ajuste el precio;
// el impacto real en costo/inventario de un modificador es una fase futura.

model FoodModifierGroup {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  minSelect      Int      @default(0) // 0 = opcional
  maxSelect      Int      @default(1) // 1 = elección única; >1 = varias
  sortOrder      Int      @default(0)
  // Eliminar un grupo cuyas opciones ya se vendieron lo desactiva (se quita
  // de los platillos y del POS) en vez de borrar sus opciones y su historial.
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id])
  options      FoodModifierOption[]
  dishLinks    FoodDishModifierGroup[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model FoodModifierOption {
  id         String  @id @default(cuid())
  groupId    String
  name       String
  // Puede ser 0 (ej. "Sin cebolla", no cambia el precio) o positivo (ej.
  // "Extra queso +$10"). Nunca negativo -- un descuento no es un
  // modificador, es una promoción, fuera de alcance por ahora.
  priceDelta Decimal @default(0) @db.Decimal(10, 2)
  sortOrder  Int     @default(0)
  // Igual que FoodDishVariant.isActive: con ventas se desactiva en vez de borrarse.
  isActive   Boolean @default(true)

  group        FoodModifierGroup              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  ingredients  FoodModifierOptionIngredient[]
  recipeUsages FoodRecipeUsage[]

  @@index([groupId])
}

// Mini-receta de una opción de modificador, por unidad del platillo con el
// que se eligió: "Extra queso" = 0.030 kg de queso. La cantidad puede ser
// negativa para opciones que quitan algo de la receta base ("Sin cebolla"
// = -0.020 kg de cebolla): devuelve lo que la receta del platillo descontó.
model FoodModifierOptionIngredient {
  id              String  @id @default(cuid())
  optionId        String
  inventoryItemId String
  quantity        Decimal @db.Decimal(10, 3)

  option        FoodModifierOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  inventoryItem FoodInventoryItem  @relation(fields: [inventoryItemId], references: [id])

  @@unique([optionId, inventoryItemId])
  @@index([optionId])
}

model FoodDishModifierGroup {
  id      String @id @default(cuid())
  dishId  String
  groupId String

  dish  FoodDish          @relation(fields: [dishId], references: [id], onDelete: Cascade)
  group FoodModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([dishId, groupId])
  @@index([dishId])
  @@index([groupId])
}

// Cuántas veces se vendió cada opción de modificador (Fase 17b: el POS
// manda un `modifiers: [{optionId, quantity}]` opcional por item de orden).
// A propósito NO tiene una relación real (FK) a FoodModifierOption: esa
// entidad SÍ se borra físicamente (a diferencia de FoodDish/FoodDishVariant,
// que solo se desactivan) -- un FK con onDelete: Cascade aquí destruiría
// este historial de ventas el día que alguien borre la opción, justo el
// problema que el soft-disable evita en el resto del módulo. En vez de
// eso, optionId es un string suelto y optionName es una foto del nombre al
// momento de la venta, para que el reporte siga siendo legible aunque la
// opción ya no exista. Sin costo de insumo todavía -- mismo alcance que
// FoodModifierOption, es insumo para un futuro costeo de modificadores,
// no lo resuelve por sí sola.
model FoodModifierOptionSale {
  id             String   @id @default(cuid())
  organizationId String
  optionId       String
  optionName     String
  // Mismo criterio de "día de negocio" que FoodDishSale.occurredAt, y la
  // misma semántica de acumulación por parte del webhook del POS (suma,
  // no reemplaza) -- ver el comentario en FoodDishSale.
  occurredAt     DateTime @default(now())
  quantity       Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([optionId, occurredAt])
  @@index([organizationId, occurredAt])
}

model FoodOperatingCost {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  // Siempre normalizado a un monto mensual -- cubre renta, nómina,
  // servicios, etc. Sin frecuencia variable por ahora (ver comentario en
  // el plan): si hace falta un gasto anual o único, se divide entre 12 al
  // capturarlo en vez de agregar una enum de frecuencia todavía sin uso real.
  amountMonthly  Decimal  @db.Decimal(10, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

// ─── RATE LIMITING ──────────────────────────────────────────────────
// DB-backed sliding window so limits hold across serverless instances
// without needing Redis. One row per attempt; see src/lib/rate-limit.ts.

model RateLimitHit {
  id        String   @id @default(cuid())
  key       String // e.g. "login:email:user@example.com", "login:ip:1.2.3.4", "webhook:automationId"
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// ─── FOOD OPS — Consumo por receta ───────────────────────────────────
// Un renglón por variante (o por opción de modificador) vendida en cada
// venta del POS o captura manual:
// cuántas unidades y qué insumos se descontaron por ellas (applied:
// { inventoryItemId: cantidad consumida }). Permite recalcular ventas
// anteriores cuando cambia una receta: se compara lo descontado con lo que
// indica la receta actual y solo se mueve la diferencia.
model FoodRecipeUsage {
  id               String                    @id @default(cuid())
  organizationId   String
  // Exactamente uno de los dos: la variante vendida o la opción de modificador.
  variantId        String?
  modifierOptionId String?
  // Con signo: una cancelación del POS o una corrección a la baja es negativa.
  units            Decimal                   @db.Decimal(12, 3)
  // Momento de la venta (o día capturado): es la fecha que usa el recálculo.
  occurredAt       DateTime
  type             FoodInventoryMovementType
  foodSaleId       String?
  applied          Json
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id])
  variant        FoodDishVariant?    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  modifierOption FoodModifierOption? @relation(fields: [modifierOptionId], references: [id], onDelete: Cascade)

  @@index([organizationId, occurredAt])
  @@index([variantId])
  @@index([modifierOptionId])
}

// ─── FOOD OPS — Delivery (Uber Eats, Rappi, DiDi Food) ───────────────
// Las plataformas solo entregan pedidos a integradores aprobados en sus
// programas de socios; Reymen los recibe ya normalizados en
// POST /api/webhooks/delivery/orders (firmado con la llave de la
// organización, igual que el POS) desde el integrador o un flujo de n8n.
// Por ahora es monitoreo: no crea ventas ni descuenta inventario.

enum DeliveryPlatform {
  UBER_EATS
  RAPPI
  DIDI_FOOD
}

enum DeliveryOrderStatus {
  NEW
  ACCEPTED
  PREPARING
  READY
  PICKED_UP
  DELIVERED
  CANCELLED
}

model DeliveryChannel {
  id             String           @id @default(cuid())
  organizationId String
  platform       DeliveryPlatform
  // Apagado: los pedidos de esa plataforma se rechazan.
  enabled        Boolean          @default(false)
  // ID de la tienda en la plataforma, para identificarla con el integrador.
  storeId        String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, platform])
}

model DeliveryOrder {
  id             String              @id @default(cuid())
  organizationId String
  platform       DeliveryPlatform
  // Id del pedido en la plataforma; repetirlo actualiza el mismo pedido.
  externalId     String
  // Código corto que ve el repartidor ("A1B2").
  displayId      String
  status         DeliveryOrderStatus @default(NEW)
  customerName   String?
  totalAmount    Decimal             @db.Decimal(10, 2)
  // [{ name, quantity, notes?, modifiers?: string[] }]
  items          Json
  notes          String?             @db.Text
  isTest         Boolean             @default(false)
  placedAt       DateTime
  statusAt       DateTime            @default(now())
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, platform, externalId])
  @@index([organizationId, placedAt])
  @@index([organizationId, status])
}
