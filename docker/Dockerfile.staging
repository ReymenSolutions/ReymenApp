FROM node:22-bookworm AS deps
WORKDIR /app
COPY package*.json ./
RUN npm ci

FROM deps AS builder
COPY . .
ENV NEXT_PUBLIC_APP_URL=http://localhost:3301
RUN npx prisma generate
# El chequeo de tipos de Next llegó al tope de memoria por omisión de Node (~2 GB) y el build moría con «heap out of memory».
ENV NODE_OPTIONS=--max-old-space-size=3072
RUN npm run build

FROM node:22-bookworm AS runner
WORKDIR /app
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0
RUN groupadd --gid 1001 nodejs && useradd --uid 1001 --gid nodejs --system nextjs
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/deploy/staging/chat-tick.mjs ./deploy/staging/chat-tick.mjs
USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
