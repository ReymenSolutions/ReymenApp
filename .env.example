# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/reymen_ops"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
# Required in production ONLY if the app sits behind a reverse proxy/load
# balancer (Nginx, an ALB, etc.) — Auth.js refuses the request Host header by
# default as a security measure. Only set this to "true" when that proxy is
# trusted to set an accurate Host/X-Forwarded-Host; never enable it if the
# app is directly reachable from the internet without such a proxy in front.
# AUTH_TRUST_HOST="true"

# n8n
N8N_BASE_URL="http://n8n:5678"
N8N_WEBHOOK_SECRET="generate-a-strong-secret"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Reymen Solutions"

# Email (Resend) — optional; without it, emails are logged to the console instead of sent
RESEND_API_KEY=""
EMAIL_FROM="Reymen Solutions <onboarding@resend.dev>"

# Reportes — tipo de cambio MXN/USD para el ROI. Se obtiene solo: de Banxico
# (FIX oficial) si BANXICO_TOKEN tiene valor, o del Banco Central Europeo
# (Frankfurter, sin llave). Token gratuito de Banxico:
# https://www.banxico.org.mx/SieAPIRest/service/v1/token
BANXICO_TOKEN=""
# Respaldo manual, pesos por dólar (ej. "18.25"): solo se usa si la fuente
# automática no responde. Sin ninguno, las oportunidades en MXN quedan fuera
# del ROI y se avisa en pantalla.
MXN_PER_USD=""

# Billing (Stripe) — optional; without STRIPE_SECRET_KEY, upgrade/manage-billing UI stays hidden
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PROFESSIONAL=""
STRIPE_PRICE_BUSINESS=""

# Error tracking (Sentry) — optional; without SENTRY_DSN, error capturing stays disabled
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Only needed to upload source maps at build time (better stack traces in Sentry)
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Intentos de login permitidos por IP cada 10 minutos (por defecto 20). Solo
# se sube en CI/e2e, donde todas las pruebas inician sesión desde la misma IP.
# LOGIN_IP_RATE_LIMIT="20"

# Webhook retry cron — required to call POST /api/cron/retry-webhooks (fails closed without it)
CRON_SECRET=""

# SmartCard integration (module NFC_QR) — /portal/smartcard renders the
# contracted-modules summary and team roster/invite natively, reading
# reymen-smartcard's own Supabase project directly (SUPABASE_URL /
# SUPABASE_SERVICE_ROLE_KEY below) instead of redirecting there. Without
# these two, the page shows a "SmartCard isn't configured" message instead
# of a 503 — same graceful-degradation intent the old SSO-only bridge had.
#
#   SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY must be the SAME project
#   reymen-smartcard's apps/ops uses (that repo's apps/ops/.env.production
#   has them as NEXT_PUBLIC_SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY — same
#   values, just without the NEXT_PUBLIC_ prefix here since this app never
#   needs a Supabase client in the browser). SUPABASE_SERVICE_ROLE_KEY
#   bypasses that project's RLS entirely — treat it exactly like any other
#   database credential with full read/write, never commit a real value.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# Dominio público que codifican los QR de las tarjetas ({url}/q/{card_code}).
# Opcional: sin valor se usa https://link.reymen.mx.
SMARTCARD_PUBLIC_URL=""

# SmartCard SSO bridge (module NFC_QR) — the original hand-off mechanism:
# mints a signed token and redirects to reymen-smartcard's own
# ops.reymen.mx, which signs the person in there via a Supabase magic link.
# /portal/smartcard no longer uses this path (see above), but
# createSmartcardSsoToken() is kept for a possible future standalone
# ops.reymen.mx login. Both values must match EXACTLY what's configured in
# reymen-smartcard's apps/ops/.env.production:
#   SMARTCARD_SSO_SECRET must equal that repo's SMARTCARD_SSO_SECRET
#   SMARTCARD_OPS_URL is that repo's public ops URL, e.g. https://ops.reymen.mx
SMARTCARD_SSO_SECRET=""
# Webhook de contactos capturados en una SmartCard → leads del CRM (docs/smartcard/CRM-LEADS.md).
# El mismo secreto lo usa reymen-smartcard para firmar. Vacío = el endpoint responde 503.
SMARTCARD_WEBHOOK_SECRET=""
SMARTCARD_OPS_URL=""

# Reymen POS — centro de operaciones (Food → Operación). URL pública del
# servidor del POS; Reymen lo consulta firmando con la llave de conexión de
# cada organización. Vacío = https://pos.reymen.mx
REYMEN_POS_URL=""

# Borradores de respuesta con IA (Inbox). Sin la clave, el inbox funciona igual y solo se apaga la sugerencia.
ANTHROPIC_API_KEY=""
# Modelo que redacta los borradores (por defecto claude-opus-5-5). Cámbialo aquí si quieres otro.
AI_DRAFT_MODEL=""
# Solo para pruebas y demos locales: "mock" genera un texto fijo sin llamar a Claude. Déjalo vacío en producción.
AI_DRAFT_PROVIDER=""
# Lealtad (Reymen Food) — Apple Wallet / Google Wallet. Opcionales: sin ellas
# la tarjeta web funciona igual y los botones de Wallet se muestran como
# "próximamente" (ver src/lib/loyalty/wallet.ts). Nunca se suben al repo.
# APPLE_WALLET_PASS_TYPE_ID=""
# APPLE_WALLET_TEAM_ID=""
# APPLE_WALLET_CERT_P12_BASE64=""
# APPLE_WALLET_CERT_PASSWORD=""
# GOOGLE_WALLET_ISSUER_ID=""
# GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=""

# ─── Mapa de Lealtad (opcional) ─────────────────────────────────────────
# Por omisión usa las teselas públicas de OpenStreetMap (sin llave). Para
# producción con tráfico real conviene un proveedor de teselas con plan
# (MapTiler, Stadia, Carto...). El host se agrega solo a la CSP.
# NEXT_PUBLIC_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
# NEXT_PUBLIC_MAP_ATTRIBUTION="&copy; OpenStreetMap"

# Sitio público de Reymen (reymen.mx) → /api/public/{leads,chat,plans}.
# Organización que recibe los contactos y el chat del sitio (slug). Por defecto: reymen-solutions.
WEB_LEADS_ORG_SLUG=""
# Orígenes extra permitidos por CORS, separados por coma (reymen.mx y www ya vienen incluidos).
WEB_ALLOWED_ORIGINS=""
# "true" publica los precios del catálogo (Admin → Planes) en /api/public/plans. Apagado = el sitio no muestra precios.
PUBLIC_PLANS_ENABLED=""

# ─── REYMEN Ops Realty: búsqueda de direcciones (opcional) ───
# Por omisión usa Nominatim de OpenStreetMap (1 petición/seg, ver docs/realty.md).
# GEOCODER_DISABLED=1
# GEOCODER_URL=   # otro servicio compatible con la API /search de Nominatim (instancia propia o proveedor)
# GEOCODER_KEY=
# GEOCODER_COUNTRY=mx
